extends layout

block content
  section.page-section
    .callout-dark
      h1.brand-title(style="color: #F7C64A; font-size: 3.5rem; margin: 0 0 0.5rem;") Downtown Donuts
      p Handcrafted donuts, locally roasted coffee, and morning staples serving downtown since 1992.
      .order-links(style="margin-top: 1.25rem;")
        a.order-btn(href="/menu") Explore Menu
        a.order-btn(href="https://www.ubereats.com" target="_blank" rel="noopener noreferrer") Order on UberEats
        a.order-btn(href="https://www.doordash.com" target="_blank" rel="noopener noreferrer") Order on DoorDash
